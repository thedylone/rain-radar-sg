<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="TimeChip">
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Small round button floating over the map. -->
    <style name="MapButton" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="iconSize">20dp</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="SectionTitle" parent="TextAppearance.Material3.TitleMedium" />
    <style name="Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
